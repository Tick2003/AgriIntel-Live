{
  "name": "AgriIntel.in — Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "runtime",
    "context": ".."
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "REPRODUCE.md",
        "app/main.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "python.formatting.provider": "none",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": true,
            "source.organizeImports.ruff": true
          }
        },
        "editor.rulers": [120]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-stubs",
        "GitHub.copilot",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "pip install -e '.[dev]' && pip install pre-commit && pre-commit install",
  "postAttachCommand": {
    "streamlit": "streamlit run app/main.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Streamlit UI",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "MLflow UI",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [8501, 8000, 5000],
  "remoteUser": "agriintel",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}